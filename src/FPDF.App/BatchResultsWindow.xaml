<Window x:Class="FPDF.App.BatchResultsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/FPDF;component/Assets/FPDF.ico" Title="FPDF — Resultado da compressão" Width="850" Height="520" MinWidth="650" MinHeight="350" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F6F9" Foreground="#18354A">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="Resultado da compressão" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><DataGrid x:Name="Results" Grid.Row="1" HeadersVisibility="Column" SizeChanged="ResultsResized" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Antes" Binding="{Binding Before}" Width="90"/><DataGridTextColumn Header="Depois" Binding="{Binding After}" Width="90"/><DataGridTextColumn Header="Resultado" Binding="{Binding Message}" Width="350"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Abrir pasta" Click="OpenFolder"/><Button Content="Concluir" Click="Finish"/></StackPanel></Grid>
</Window>
