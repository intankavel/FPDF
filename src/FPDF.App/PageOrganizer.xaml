<Window Icon="/FPDF;component/Assets/FPDF.ico" x:Class="FPDF.App.PageOrganizer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FPDF — Visualizar e organizar páginas" Width="1100" Height="840" MinWidth="850" MinHeight="650" Background="#F3F6F9" Foreground="#18354A" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="Visualizar e organizar páginas" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="DocumentName" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="Arraste uma página sobre outra para mudar sua posição. Selecione uma página para vê-la ampliada." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="SignatureStatus" Text="Verificando campos de assinatura…" TextWrapping="Wrap" Foreground="#78654A" Margin="0,6,0,0"/></StackPanel>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,12" IsEnabled="False"><Button Content="← Anterior na ordem" Click="MovePrevious"/><Button Content="Próxima na ordem →" Click="MoveNext"/><Button Content="Excluir página" Click="DeletePage"/><Button Content="Desfazer" Click="Undo"/><Button Content="Restaurar original" Click="Reset"/><Button x:Name="MoreButton" Content="Carregar mais miniaturas" Click="LoadMore"/></WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Pages" SelectionChanged="PageSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#E8EEF3" BorderThickness="0" AllowDrop="True" PreviewMouseLeftButtonDown="DragStarted" PreviewMouseMove="DragMoved" Drop="PageDropped">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Width="136" Margin="5"><Grid Height="168" Background="White"><TextBlock Text="Miniatura a carregar" Foreground="#738493" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="PreviewCaption" Text="Selecione uma página" Margin="0,0,0,8"/><WrapPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Zoom" Width="130" SelectedIndex="0" SelectionChanged="ZoomChanged"><ComboBoxItem Content="Ajustar à janela"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/></ComboBox></WrapPanel><ScrollViewer x:Name="PreviewScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewResized"><Image x:Name="LargePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/></ScrollViewer></Grid></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveButton" Content="Salvar novo PDF…" Click="Save" Background="#087E82" Foreground="White" IsEnabled="False"/><Button Content="Fechar" Click="CloseWindow"/></StackPanel><TextBlock x:Name="Status" Text="Carregando documento…" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
 </Grid>
</Window>
