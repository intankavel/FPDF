<Window Icon="/FPDF;component/Assets/FPDF.ico" x:Class="FPDF.App.DependenciesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FPDF — Preparar este computador" Width="650" Height="630" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6F9" FontFamily="Segoe UI" FontSize="14" Foreground="#18354A">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Componentes do FPDF" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="PackageInfo" Text="O portátil completo inclui .NET, PDFtk e Ghostscript. Mantenha toda a pasta extraída junta. Os links abaixo servem para instalações alternativas." TextWrapping="Wrap" Margin="0,14,0,16"/>
 <TextBlock Text="PDFtk Server — para editar os documentos" FontWeight="SemiBold"/><TextBlock x:Name="PdftkStatus" Margin="0,5,0,5"/><Button Content="Abrir download oficial do PDFtk Server" Click="DownloadPdftk" HorizontalAlignment="Left"/>
 <TextBlock Text="Ghostscript AGPL de 64 bits — para compressão e visualização" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock x:Name="GhostscriptStatus" Margin="0,5,0,5"/><Button Content="Abrir download oficial do Ghostscript" Click="DownloadGhostscript" HorizontalAlignment="Left"/>
 <TextBlock Text="OCR — para reconhecer texto em digitalizações" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock x:Name="OcrStatus" TextWrapping="Wrap" Margin="0,5,0,5"/><Button Content="Abrir instruções do OCR local" Click="OcrInstructions" HorizontalAlignment="Left"/>
 <TextBlock Text="Se um componente do portátil faltar, extraia novamente o ZIP completo. Para usar instalações alternativas, mantenha as pastas padrão dos instaladores e clique em Verificar novamente. Os componentes têm suas próprias licenças." TextWrapping="Wrap" Margin="0,14,0,14"/>
 <WrapPanel><Button Content="Verificar novamente" Click="Refresh"/><Button Content="Concluir" Click="Finish"/></WrapPanel><TextBlock x:Name="Status" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Window>
